{
    "name": "x2y/hyperswitch-client",
    "description": "Pure PHP SDK for the Hyperswitch payment orchestration API.",
    "type": "library",
    "license": "MIT",
    "keywords": ["hyperswitch", "payments", "api", "sdk", "psr-18"],
    "homepage": "https://github.com/x2yio/hyperswitch-client-php",
    "require": {
        "php": "^8.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^1.12 || ^2.0",
        "phpstan/phpstan-strict-rules": "^1.6 || ^2.0",
        "symfony/http-client": "^6.4 || ^7.0",
        "nyholm/psr7": "^1.8",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "X2Y\\HyperswitchClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "X2Y\\HyperswitchClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=unit",
        "test:drift": "phpunit --testsuite=drift",
        "test:integration": "phpunit --testsuite=integration",
        "stan": "phpstan analyse",
        "ci": ["@test:unit", "@test:drift", "@stan"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
